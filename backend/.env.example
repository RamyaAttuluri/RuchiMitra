DATABASE_URL=file:./dev.db
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000
AI_PROVIDER=ollama
OLLAMA_CONNECT_TIMEOUT_MS=5000
OLLAMA_GENERATION_TIMEOUT_MS=240000
OLLAMA_TRANSLATION_TIMEOUT_MS=300000
AI_QUEUE_LIMIT=6
AI_QUEUE_TIMEOUT_MS=90000
PDF_TIMEOUT_MS=45000
# Optional absolute path to Chrome/Edge for PDF export. Windows defaults to installed Edge.
# PDF_BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Increment after replacing a model under the same tag to invalidate generated cache entries.
OLLAMA_MODEL_VERSION=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
AI_MAX_CONCURRENT=1
AI_REQUESTS_PER_HOUR=120
TRANSLATION_PROVIDER=ollama
LOCAL_INFERENCE_URL=http://127.0.0.1:8001
TRANSLATION_INFERENCE_URL=http://127.0.0.1:8002
TTS_PROVIDER=auto
TTS_TIMEOUT_MS=180000
# Change this in both services after changing model assets or reference voice.
TTS_MODEL_VERSION=indicf5-v1
# Cloud providers require explicit opt-in (AI_PROVIDER/TRANSLATION_PROVIDER=gemini,
# TTS_PROVIDER=gemini or google). No cloud key is required for local narration.
GEMINI_API_KEY=
GOOGLE_TTS_API_KEY=
# Backup Gemini models tried in order when GEMINI_MODEL is overloaded (503) or rate limited.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite
OLLAMA_TIMEOUT_MS=240000
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_OUTPUT_TOKENS=3072
OLLAMA_NUM_THREADS=2
TTS_CACHE_ENABLED=true
